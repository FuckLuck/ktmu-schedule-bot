# Токен Telegram-бота от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Базовый URL расписания колледжа КТМУ
BASE_URL=https://timetable-ktmu.ru

# Путь к файлу базы данных SQLite
DATABASE_PATH=ktmu_bot.db

# Часовой пояс для планировщика и дат (по умолчанию Москва/СПб: Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время жизни кэша расписания (в часах)
CACHE_TTL_HOURS=6

# Лимит антиспама / троттлинга (минимальная пауза между запросами пользователя в секундах)
THROTTLING_RATE_LIMIT=0.8
